---
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow/700.css";
import "@fontsource/barlow-semi-condensed/500.css";
import "@fontsource/barlow-semi-condensed/600.css";
import "@fontsource/barlow-semi-condensed/700.css";
import "../styles/tokens.css";
import "../styles/global.css";
import AppHeader from "../components/AppHeader.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Applies the stored or system theme before first paint. Mirrors resolveTheme in src/lib/theme.ts. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("ms-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme =
            stored === "dark" || stored === "light" ? stored : prefersDark ? "dark" : "light";
        } catch (error) {
          // Storage or matchMedia unavailable: the CSS media query still picks the theme.
        }
      })();
    </script>
  </head>
  <body>
    <AppHeader>{Astro.slots.has("header-start") && <slot name="header-start" />}</AppHeader>
    <main class="page">
      <slot />
    </main>
  </body>
</html>
