---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base title="Match Stats">
  <h1>Match Stats</h1>

  <div class="compare-block">
    <button id="compare-toggle" type="button" class="compare-toggle" aria-expanded="false" aria-controls="compare-panel">
      <span>Comparar equipos</span>
      <span class="compare-chevron"><Icon name="chevron-left" size={18} /></span>
    </button>
    <div id="compare-panel" class="compare-panel" data-open="false" inert>
      <div class="compare-inner">
        <form id="picker" class="card">
          <label class="field">
            Liga
            <select id="league" disabled>
              <option value="">Cargando ligas…</option>
            </select>
          </label>
          <label class="field">
            Local
            <select id="home" disabled>
              <option value="">Elige un equipo</option>
            </select>
          </label>
          <label class="field">
            Visitante
            <select id="away" disabled>
              <option value="">Elige un equipo</option>
            </select>
          </label>
          <button id="analyze" type="submit" class="btn" disabled>Analizar</button>
        </form>
      </div>
    </div>
  </div>

  <section class="calendar">
    <div class="seg" role="tablist" aria-label="Día">
      <button
        type="button"
        role="tab"
        id="tab-today"
        class="seg-btn"
        data-day="today"
        aria-selected="true"
        aria-controls="day-panel"
        tabindex="0">Hoy</button
      >
      <button
        type="button"
        role="tab"
        id="tab-tomorrow"
        class="seg-btn"
        data-day="tomorrow"
        aria-selected="false"
        aria-controls="day-panel"
        tabindex="-1">Mañana</button
      >
    </div>
    <p id="updated" class="muted updated"></p>
    <div class="cal-controls">
      <div id="competition-filter" class="chip-row" role="group" aria-label="Filtrar por liga"></div>
      <div class="seg" role="radiogroup" aria-label="Orden de los partidos">
        <button type="button" role="radio" class="seg-btn" data-order="time" aria-checked="true" tabindex="0">Por hora</button>
        <button type="button" role="radio" class="seg-btn" data-order="league" aria-checked="false" tabindex="-1">Por liga</button>
      </div>
    </div>
    <div id="day-panel" role="tabpanel" aria-labelledby="tab-today" tabindex="0">
      <p id="status" class="muted" aria-live="polite" hidden></p>
      <div id="filter-empty" class="filter-empty" hidden>
        <p class="muted">No hay partidos de estas ligas este día.</p>
        <button id="reset-filter" type="button" class="reset-filter">Ver todas</button>
      </div>
      <ul id="fixtures" class="fixtures"></ul>
    </div>
  </section>
</Base>

<style is:global>
  .calendar {
    margin-top: 24px;
  }

  .updated {
    margin: 10px 0 8px;
    font-size: 0.875rem;
  }

  .cal-controls {
    display: grid;
    gap: 10px;
    min-width: 0;
    margin: 10px 0 12px;
  }

  .chip-row {
    display: flex;
    gap: 8px;
    min-width: 0;
    overflow-x: auto;
    padding: 2px;
    scrollbar-width: none;
  }

  .chip-row::-webkit-scrollbar {
    display: none;
  }

  .filter-chip {
    flex: 0 0 auto;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  .filter-chip:hover {
    color: var(--text);
    border-color: var(--muted);
  }

  .filter-chip[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .filter-empty {
    display: grid;
    justify-items: start;
    gap: 8px;
    padding: 12px 0;
  }

  .reset-filter {
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .group {
    display: grid;
    gap: 8px;
  }

  .group-title {
    margin: 8px 0 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }

  .fixtures {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    transition: opacity 180ms var(--ease-out);
  }

  #day-panel[aria-busy="true"] .fixtures {
    opacity: 0.5;
  }

  .fixture-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color 180ms var(--ease-out);
  }

  a.fixture-row:hover {
    border-color: var(--muted);
  }

  .kickoff {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .fixture-main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .fixture {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .league-name {
    font-size: 0.8125rem;
  }

  .probs {
    display: grid;
    justify-items: end;
    gap: 2px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .prob {
    display: flex;
    gap: 6px;
    align-items: baseline;
  }

  .prob-label {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .prob.is-accent {
    color: var(--accent);
  }

  .compare-block {
    margin-top: 24px;
  }

  .compare-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: border-color 180ms var(--ease-out);
  }

  .compare-toggle:hover {
    border-color: var(--muted);
  }

  .compare-chevron {
    display: inline-flex;
    transform: rotate(-90deg);
    transition: transform 180ms var(--ease-out);
  }

  .compare-toggle[aria-expanded="true"] .compare-chevron {
    transform: rotate(90deg);
  }

  .compare-panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 180ms var(--ease-out),
      opacity 180ms var(--ease-out);
  }

  .compare-panel[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .compare-inner {
    min-height: 0;
    overflow: hidden;
  }

  .compare-inner > .card {
    margin-top: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .compare-panel,
    .compare-chevron,
    .compare-toggle,
    .filter-chip {
      transition: none;
    }
  }

  @media (max-width: 400px) {
    .fixture-row {
      grid-template-columns: 48px minmax(0, 1fr);
    }

    .probs {
      grid-column: 2;
      grid-auto-flow: column;
      justify-items: start;
      justify-content: start;
      gap: 12px;
    }
  }
</style>

<script>
  import {
    competitionsOf,
    filterByCompetitions,
    formatDayLabel,
    formatKickoff,
    groupByCompetition,
    groupByLocalDay,
    isAnalyzable,
    isCrossLeagueUefa,
    uefaMatchUrl,
  } from "../lib/calendar";
  import { loadIndex, loadLeague, loadUefa } from "../lib/data";
  import { shortName } from "../lib/leagues";
  import {
    MATCH_LINES,
    TeamNotFoundError,
    crossLeagueAvailable,
    crossLeagueMarkets,
    matchMarkets,
  } from "../lib/markets";
  import type { Market } from "../lib/markets";
  import { escapeHtml, formatPct } from "../lib/render";
  import type { IndexData, LeagueData, UefaData, UpcomingMatch } from "../lib/types";

  type Day = "today" | "tomorrow";
  type Order = "time" | "league";

  const base = import.meta.env.BASE_URL;
  const DAY_MS = 24 * 60 * 60 * 1000;
  const ACCENT_FROM = 0.6;
  const COMPETITIONS_KEY = "ms-cal-leagues";
  const ORDER_KEY = "ms-cal-order";
  const EMPTY_DAY = "Todavía no hay partidos publicados para este día.";
  const LOAD_ERROR = "No se pudieron cargar los datos. Intenta de nuevo más tarde.";
  const NO_ANALYSIS = "Sin análisis: equipos de distintas categorías.";

  function byId<T extends HTMLElement>(id: string): T {
    const element = document.getElementById(id);
    if (!element) throw new Error(`Missing #${id}`);
    return element as T;
  }

  const leagueSelect = byId<HTMLSelectElement>("league");
  const homeSelect = byId<HTMLSelectElement>("home");
  const awaySelect = byId<HTMLSelectElement>("away");
  const analyze = byId<HTMLButtonElement>("analyze");
  const picker = byId<HTMLFormElement>("picker");
  const compareToggle = byId<HTMLButtonElement>("compare-toggle");
  const comparePanel = byId<HTMLDivElement>("compare-panel");
  const dayTabs = [...document.querySelectorAll<HTMLButtonElement>("[role='tab'][data-day]")];
  const orderButtons = [...document.querySelectorAll<HTMLButtonElement>("[role='radio'][data-order]")];
  const chipRow = byId<HTMLDivElement>("competition-filter");
  const filterEmpty = byId<HTMLDivElement>("filter-empty");
  const resetFilter = byId<HTMLButtonElement>("reset-filter");
  const dayPanel = byId<HTMLDivElement>("day-panel");
  const fixtureList = byId<HTMLUListElement>("fixtures");
  const status = byId<HTMLParagraphElement>("status");
  const updated = byId<HTMLParagraphElement>("updated");

  // Each league's JSON is fetched at most once, and only when a listed day needs it.
  const leagueCache = new Map<string, Promise<LeagueData>>();
  let index: IndexData | null = null;
  // Null when uefa.json is missing or unusable: UEFA matches then show no probabilities.
  let uefa: UefaData | null = null;
  let groups: Record<Day, UpcomingMatch[]> = { today: [], tomorrow: [] };
  let selectedLeague = "";
  let selectedDay: Day = "today";
  const selectedCompetitions = loadCompetitions();
  let order: Order = loadOrder();
  let renderId = 0;

  function loadCompetitions(): Set<string> {
    try {
      const parsed: unknown = JSON.parse(localStorage.getItem(COMPETITIONS_KEY) ?? "[]");
      return new Set(Array.isArray(parsed) ? parsed.filter((code): code is string => typeof code === "string") : []);
    } catch {
      return new Set();
    }
  }

  function saveCompetitions(): void {
    try {
      localStorage.setItem(COMPETITIONS_KEY, JSON.stringify([...selectedCompetitions]));
    } catch {
      // Storage can be blocked (private window): the filter still works for this visit.
    }
  }

  function loadOrder(): Order {
    try {
      return localStorage.getItem(ORDER_KEY) === "league" ? "league" : "time";
    } catch {
      return "time";
    }
  }

  function saveOrder(): void {
    try {
      localStorage.setItem(ORDER_KEY, order);
    } catch {
      // Storage can be blocked (private window): the order still works for this visit.
    }
  }

  function loadLeagueOnce(code: string): Promise<LeagueData> {
    let pending = leagueCache.get(code);
    if (!pending) {
      pending = loadLeague(code);
      leagueCache.set(code, pending);
    }
    return pending;
  }

  function matchHref(match: UpcomingMatch, league: string): string {
    const params = new URLSearchParams({ league, home: match.home, away: match.away });
    return `${base}match?${params.toString()}`;
  }

  function showStatus(text: string): void {
    status.hidden = text === "";
    status.textContent = text;
  }

  function updateAnalyze(): void {
    const home = homeSelect.value;
    const away = awaySelect.value;
    analyze.disabled = !home || !away || home === away;
  }

  function fillTeamSelects(): void {
    const teams = index?.leagues.find((league) => league.code === selectedLeague)?.teams ?? [];
    for (const select of [homeSelect, awaySelect]) {
      select.replaceChildren(new Option("Elige un equipo", ""), ...teams.map((team) => new Option(team, team)));
      select.disabled = teams.length === 0;
    }
    updateAnalyze();
  }

  function selectLeague(code: string): void {
    selectedLeague = code;
    leagueSelect.value = code;
    fillTeamSelects();
  }

  function setCompareOpen(open: boolean): void {
    compareToggle.setAttribute("aria-expanded", String(open));
    comparePanel.dataset.open = String(open);
    comparePanel.inert = !open;
  }

  /** Markets from `compute`, or null when a team is not in the data. Other errors are logged. */
  function marketsOrNull(compute: () => Market[]): Market[] | null {
    try {
      return compute();
    } catch (error) {
      if (!(error instanceof TeamNotFoundError)) console.error(error);
      return null;
    }
  }

  /** Markets of a league match; null when its league is not loaded. */
  function leagueMarketsOf(match: UpcomingMatch, leagues: Map<string, LeagueData>): Market[] | null {
    const league = match.league && isAnalyzable(match) ? leagues.get(match.league) : undefined;
    if (!league) return null;
    return marketsOrNull(() => matchMarkets(league, match.home, match.away));
  }

  /** Markets of a cross-league UEFA match; null unless uefa.json prices the pair and both leagues are loaded. */
  function crossLeagueMarketsOf(match: UpcomingMatch, leagues: Map<string, LeagueData>): Market[] | null {
    const { home_league: homeCode, away_league: awayCode } = match;
    const data = uefa;
    if (!isCrossLeagueUefa(match) || !homeCode || !awayCode || !data) return null;
    const homeLeague = leagues.get(homeCode);
    const awayLeague = leagues.get(awayCode);
    if (!homeLeague || !awayLeague || !crossLeagueAvailable(data, homeCode, awayCode)) return null;
    return marketsOrNull(() =>
      crossLeagueMarkets(
        { name: match.home, code: homeCode, league: homeLeague },
        { name: match.away, code: awayCode, league: awayLeague },
        data,
      ),
    );
  }

  /** League codes whose data a row needs: its own league, or both teams' leagues for a priced UEFA match. */
  function neededLeagues(match: UpcomingMatch): string[] {
    if (isCrossLeagueUefa(match) && match.home_league && match.away_league) {
      return crossLeagueAvailable(uefa, match.home_league, match.away_league)
        ? [match.home_league, match.away_league]
        : [];
    }
    return match.league && isAnalyzable(match) ? [match.league] : [];
  }

  /** Probabilities for the "1" and "Más de 2.5" rows; empty when there are no markets. */
  function probabilityHtml(markets: Market[] | null): string {
    if (!markets) return "";
    const find = (id: string): Market | undefined => markets.find((market) => market.id === id);
    const one = find("1");
    const draw = find("X");
    const away = find("2");
    const over = find("goals_over");
    if (!one || !draw || !away || !over) return "";

    const favorite = [one, draw, away].reduce((best, market) => (market.probability > best.probability ? market : best));
    const oneAccent = favorite === one || one.probability >= ACCENT_FROM;
    const overAccent = over.probability >= ACCENT_FROM;
    return `<span class="probs num">
    <span class="prob${oneAccent ? " is-accent" : ""}"><span class="prob-label">1</span>${formatPct(one.probability)}</span>
    <span class="prob${overAccent ? " is-accent" : ""}"><span class="prob-label">Más de ${MATCH_LINES.goals}</span>${formatPct(over.probability)}</span>
  </span>`;
  }

  function rowHtml(match: UpcomingMatch, leagues: Map<string, LeagueData>): string {
    const kickoff = `<span class="kickoff num">${escapeHtml(formatKickoff(match.kickoff_utc))}</span>`;
    const name = escapeHtml(shortName(match.competition, match.competition_name));

    if (isCrossLeagueUefa(match)) {
      return `<li><a class="fixture-row" href="${escapeHtml(uefaMatchUrl(base, match))}">
  ${kickoff}
  <span class="fixture-main">
    <span class="fixture">${escapeHtml(match.home)} vs ${escapeHtml(match.away)}</span>
    <span class="muted league-name">${name}</span>
  </span>
  ${probabilityHtml(crossLeagueMarketsOf(match, leagues))}
</a></li>`;
    }

    if (!isAnalyzable(match) || !match.league) {
      return `<li><div class="fixture-row">
  ${kickoff}
  <span class="fixture-main">
    <span class="fixture">${escapeHtml(match.home)} vs ${escapeHtml(match.away)}</span>
    <span class="muted league-name">${name}</span>
    <span class="muted league-name">${escapeHtml(NO_ANALYSIS)}</span>
  </span>
</div></li>`;
    }

    return `<li><a class="fixture-row" href="${escapeHtml(matchHref(match, match.league))}">
  ${kickoff}
  <span class="fixture-main">
    <span class="fixture">${escapeHtml(match.home)} vs ${escapeHtml(match.away)}</span>
    <span class="muted league-name">${name}</span>
  </span>
  ${probabilityHtml(leagueMarketsOf(match, leagues))}
</a></li>`;
  }

  /** One chip per competition of the day, with "Todas" first. Chips show the active selection. */
  function renderChips(matches: UpcomingMatch[]): void {
    const chip = (code: string | null, label: string, pressed: boolean): string => {
      const attribute = code === null ? "data-all" : `data-competition="${escapeHtml(code)}"`;
      return `<button type="button" class="filter-chip" ${attribute} aria-pressed="${pressed}">${escapeHtml(label)}</button>`;
    };
    const names = new Map(matches.map((match) => [match.competition, shortName(match.competition, match.competition_name)]));
    chipRow.innerHTML = [
      chip(null, "Todas", selectedCompetitions.size === 0),
      ...competitionsOf(matches).map((code) => chip(code, names.get(code) ?? code, selectedCompetitions.has(code))),
    ].join("");
  }

  function groupsHtml(matches: UpcomingMatch[], leagues: Map<string, LeagueData>): string {
    return groupByCompetition(matches)
      .map(({ competition, matches: group }) => {
        const title = escapeHtml(`${shortName(competition, group[0].competition_name)} · ${group.length}`);
        const rows = group.map((match) => rowHtml(match, leagues));
        return `<li class="group"><h3 class="group-title">${title}</h3><ul class="fixtures">${rows.join("")}</ul></li>`;
      })
      .join("");
  }

  async function renderDay(): Promise<void> {
    if (!index) return;
    const id = ++renderId;
    const matches = groups[selectedDay];
    fixtureList.innerHTML = "";
    filterEmpty.hidden = true;
    renderChips(matches);

    if (matches.length === 0) {
      dayPanel.removeAttribute("aria-busy");
      showStatus(EMPTY_DAY);
      return;
    }
    showStatus("");

    const visible = filterByCompetitions(matches, selectedCompetitions);
    if (visible.length === 0) {
      dayPanel.removeAttribute("aria-busy");
      filterEmpty.hidden = false;
      return;
    }
    dayPanel.setAttribute("aria-busy", "true");

    const codes = [...new Set(visible.flatMap(neededLeagues))];
    const leagues = new Map<string, LeagueData>();
    await Promise.all(
      codes.map(async (code) => {
        try {
          leagues.set(code, await loadLeagueOnce(code));
        } catch (error) {
          console.error(error);
        }
      }),
    );
    if (id !== renderId) return;

    fixtureList.innerHTML =
      order === "league"
        ? groupsHtml(visible, leagues)
        : visible.map((match) => rowHtml(match, leagues)).join("");
    dayPanel.removeAttribute("aria-busy");
  }

  function selectDay(day: Day, focus = false): void {
    selectedDay = day;
    for (const tab of dayTabs) {
      const active = tab.dataset.day === day;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    }
    dayPanel.setAttribute("aria-labelledby", `tab-${day}`);
    void renderDay();
  }

  function paintOrder(): void {
    for (const button of orderButtons) {
      const active = button.dataset.order === order;
      button.setAttribute("aria-checked", String(active));
      button.tabIndex = active ? 0 : -1;
    }
  }

  function selectOrder(next: Order): void {
    order = next;
    paintOrder();
    saveOrder();
    void renderDay();
  }

  /** Left and right arrows move through a radio group or tab list, as the ARIA pattern expects. */
  function bindArrowKeys(items: HTMLButtonElement[], onSelect: (item: HTMLButtonElement) => void): void {
    items.forEach((item, position) => {
      item.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const next = items[(position + step + items.length) % items.length];
        next.focus();
        onSelect(next);
      });
    });
  }

  async function main(): Promise<void> {
    const now = new Date();
    const [todayTab, tomorrowTab] = dayTabs;
    todayTab.textContent = `Hoy · ${formatDayLabel(now)}`;
    tomorrowTab.textContent = `Mañana · ${formatDayLabel(new Date(now.getTime() + DAY_MS))}`;

    compareToggle.addEventListener("click", () => {
      setCompareOpen(compareToggle.getAttribute("aria-expanded") !== "true");
    });
    leagueSelect.addEventListener("change", () => selectLeague(leagueSelect.value));
    dayTabs.forEach((tab) => {
      tab.addEventListener("click", () => selectDay(tab.dataset.day as Day));
    });
    bindArrowKeys(dayTabs, (tab) => selectDay(tab.dataset.day as Day, true));
    orderButtons.forEach((button) => {
      button.addEventListener("click", () => selectOrder(button.dataset.order as Order));
    });
    bindArrowKeys(orderButtons, (button) => selectOrder(button.dataset.order as Order));
    chipRow.addEventListener("click", (event) => {
      const chip = event.target instanceof Element ? event.target.closest<HTMLButtonElement>("[data-all], [data-competition]") : null;
      if (!chip) return;
      if (chip.hasAttribute("data-all")) {
        selectedCompetitions.clear();
      } else {
        const code = chip.dataset.competition ?? "";
        if (selectedCompetitions.has(code)) selectedCompetitions.delete(code);
        else selectedCompetitions.add(code);
      }
      saveCompetitions();
      void renderDay();
    });
    resetFilter.addEventListener("click", () => {
      selectedCompetitions.clear();
      saveCompetitions();
      void renderDay();
    });

    homeSelect.addEventListener("change", updateAnalyze);
    awaySelect.addEventListener("change", updateAnalyze);
    picker.addEventListener("submit", (event) => {
      event.preventDefault();
      if (analyze.disabled) return;
      const params = new URLSearchParams({
        league: selectedLeague,
        home: homeSelect.value,
        away: awaySelect.value,
      });
      window.location.href = `${base}match?${params.toString()}`;
    });

    paintOrder();
    setCompareOpen(false);

    try {
      index = await loadIndex();
    } catch (error) {
      console.error(error);
      showStatus(LOAD_ERROR);
      return;
    }

    uefa = await loadUefa();

    leagueSelect.replaceChildren(...index.leagues.map((league) => new Option(shortName(league.code, league.name), league.code)));
    leagueSelect.disabled = index.leagues.length === 0;
    selectLeague(index.leagues[0]?.code ?? "");

    groups = groupByLocalDay(index.upcoming ?? [], now);
    updated.textContent = `Actualizado a las ${formatKickoff(index.generated_at)}`;
    selectDay(selectedDay);
  }

  main();
</script>
